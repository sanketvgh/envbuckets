[windows] skip 'Unix permission bits required'
exec git init -q
exec git add README
exec git commit -qm initial
chmod 000 .env key.json
exec envbuckets init
! stdout SYNTHETIC
! stderr SYNTHETIC
readlink .env .env.d/dev/.env
exec envbuckets add key.json
! stdout .
! stderr .
readlink key.json .env.d/dev/key.json
exec envbuckets switch -c prod
cmp .env.d/prod/.env empty
cmp .env.d/prod/key.json empty
chmod 600 .env.d/dev/.env .env.d/dev/key.json
cmp .env.d/dev/.env original-env
cmp .env.d/dev/key.json original-key

-- README --
synthetic fixture
-- .env --
SYNTHETIC_UNREADABLE_ENV
-- original-env --
SYNTHETIC_UNREADABLE_ENV
-- key.json --
SYNTHETIC_UNREADABLE_KEY
-- original-key --
SYNTHETIC_UNREADABLE_KEY
-- empty --
