# Bucket and map refusal paths preserve the project while successful edits
# remain visible through list commands.
[!exec:git] skip 'git is required'

exec git init -q -b main
exec envbuckets init
exec envbuckets bucket add dev
exec envbuckets bucket add prod
exec envbuckets bucket list
stdout 'dev'
stdout 'prod'
exec envbuckets map add 'release/*' prod
exec envbuckets map add '*' dev
exec envbuckets map list
stdout 'release/\*'
stdout '\* .*-> dev'
! exec envbuckets map add 'hotfix/*' dev
stderr 'catch-all.*must stay last'
! exec envbuckets map add 'release/*' dev
stderr 'catch-all.*must stay last'
! exec envbuckets bucket rm prod
stderr 'still referenced by rules'
! exec envbuckets bucket rm dev
stderr 'still referenced by rules'
exec envbuckets map rm '*'
exec envbuckets map rm 'release/*'
exec envbuckets bucket rm prod
stdout 'removed bucket prod'

-- README --
fixture
