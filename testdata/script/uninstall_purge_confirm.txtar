# A JSON purge cannot confirm deletion and leaves links, bucket files, and
# the hook unchanged.
[!exec:git] skip 'git is required'
[!symlink] skip 'symlinks are required'

exec git init -q -b main
exec envbuckets init --into dev
readlink .env .env.d/dev/.env
! exec envbuckets uninstall --purge --json
stdout '"exit_code":1'
readlink .env .env.d/dev/.env
exists .env.d/dev/.env
exists .git/hooks/post-checkout

-- README --
fixture
-- .env --
SYNTHETIC=1
