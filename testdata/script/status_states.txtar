# Status and map output remain useful before any .env is initialized.
[!exec:git] skip 'git is required'
[!symlink] skip 'symlinks are required'

exec git init -q -b main
exec envbuckets init
exec envbuckets scope add . --name root
exec envbuckets status
stdout 'On branch main'
stdout 'root.*\.env missing'
exec envbuckets bucket add dev --scope root
exec envbuckets bucket list --scope root
stdout 'dev'
exec envbuckets map add '*' dev
exec envbuckets status
stdout 'Using bucket dev \(rule \*, priority 1\)'
exec envbuckets map list
stdout '\* 1\. .*-> dev'
exec envbuckets map rm '*'
stdout 'removed rule \*'

-- README --
fixture
