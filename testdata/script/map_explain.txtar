# map explain resolves any branch name read-only: pin first, then the
# first matching rule, with per-scope target availability.
[!exec:git] skip 'git is required'
[!symlink] skip 'symlinks are required'

exec git init -q -b main
exec git add README
exec git commit -q -m init
mkdir apps/a apps/b
exec envbuckets init
exec envbuckets scope add apps/a
exec envbuckets scope add apps/b
exec envbuckets bucket add staging --scope a
exec envbuckets bucket add staging --scope b
exec envbuckets bucket add prod --scope a
exec envbuckets map add main staging
exec envbuckets map add 'release/*' prod
cp .envbuckets.toml before.toml

exec envbuckets map explain release/9
stdout 'branch: release/9 \(no local branch, explained as if checked out\)'
stdout 'rule:   2\. release/\* -> prod \(first match wins\)'
stdout 'a +available apps/a/\.env\.d/prod/\.env'
stdout 'b +missing apps/b/\.env\.d/prod/\.env'
stdout 'next: envbuckets bucket add prod --all'
! exists apps/b/.env.d/prod

exec envbuckets map explain main
stdout 'branch: main \(current\)'
stdout 'b +available apps/b/\.env\.d/staging/\.env \| active: none'

exec git branch release/1
exec envbuckets link staging --branch release/1
exec envbuckets map explain release/1
stdout 'link:   staging \(local pin, overrides rules\)'
stdout 'overridden by the pin'

exec envbuckets map explain hotfix/1
stdout 'rule:   none matches'
! stdout 'scopes:'

! exec envbuckets map explain
stderr 'expected one <branch>'
cmp .envbuckets.toml before.toml

-- README --
fixture
