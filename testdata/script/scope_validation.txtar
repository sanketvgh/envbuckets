# Invalid scope paths must be refused without creating registrations.
[!exec:git] skip 'git is required'
[!symlink] skip 'symlinks are required'

exec git init -q -b main
exec envbuckets init
mkdir apps
mkdir apps/api
exec envbuckets scope add apps --name apps
! exec envbuckets scope add apps/api --name api
stderr 'nested scopes are not supported'
! exec envbuckets scope add apps --name duplicate
stderr 'path apps is already registered'
! exec envbuckets scope add missing --name missing
stderr 'missing is not an existing directory'
! exec envbuckets scope add ../outside --name outside
stderr 'not an existing directory'
exec envbuckets scope list
stdout 'apps.*apps'
! stdout 'api'

-- .gitignore --
fixture
